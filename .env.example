# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

# Used server-side (SSR, server functions, auth middleware)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Service role key: server-only, bypasses RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Same values, exposed to the client bundle via Vite's VITE_ prefix
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
